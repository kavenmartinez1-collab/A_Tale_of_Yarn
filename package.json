{
  "name": "artifex-webgpu",
  "version": "0.1.0",
  "description": "Artifex WebGPU Inference Engine \u2014 browser-based LLM inference for any GPU",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx server/dev-server.ts\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "tsx server/dev-server.ts",
    "typecheck": "tsc --noEmit",
    "test:mesh": "tsx scripts/check-winding.mts && tsx scripts/test-character-mesh.mts && tsx scripts/test-animal-mesh.mts && tsx scripts/test-boss-mesh.mts",
    "test:combat": "tsx scripts/test-attack-routing.mts && tsx scripts/test-projectiles.mts && tsx scripts/test-aim.mts && tsx scripts/test-animal-ai.mts && tsx scripts/test-mounting.mts && tsx scripts/test-attack-tokens.mts && tsx scripts/test-lock-on.mts && tsx scripts/test-dungeon-combat.mts",
    "test:world": "tsx scripts/test-roads.mts",
    "test:castle": "tsx scripts/test-castle-layout.mts && tsx scripts/test-castle-zfight.mts",
    "test:pause": "tsx scripts/test-sim-clock.mts && tsx scripts/test-map.mts && tsx scripts/test-save-slots.mts",
    "test:input": "tsx scripts/test-gamepad.mts",
    "voice:fixture": "tsx scripts/gen-voice-fixture.mts",
    "test:voice": "tsx scripts/test-voice-accuracy.mts",
    "weights": "tsx scripts/fetch-weights.mts",
    "pack:steam": "node scripts/pack-steam.mjs",
    "check:steam": "node scripts/steam-pack-check.mjs",
    "check:steam:control": "node scripts/steam-pack-check.mjs --control",
    "play:castle": "node scripts/castle-escape.mjs",
    "play:pause": "node scripts/pause-check.mjs",
    "play:map": "node scripts/map-discovery-check.mjs && node scripts/map-look.mjs",
    "play:saves": "node scripts/save-delete-check.mjs",
    "play:wells": "node scripts/well-drink-check.mjs",
    "play:evict": "node scripts/settlement-evict-check.mjs",
    "play:torch": "node scripts/torch-check.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "play:controller": "node scripts/controller-ui-check.mjs",
    "play:combat": "node scripts/combat-feel-check.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "steamworks.js": "github:ceifa/steamworks.js",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.4",
    "@playwright/test": "^1.60.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.18.1",
    "@webgpu/types": "^0.1.52",
    "concurrently": "^9.1.0",
    "electron": "^43.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
